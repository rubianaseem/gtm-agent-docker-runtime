# Copy to .env for plain venv runs. Never commit .env. Docker runs use files in ./secrets instead.
CRM_BASE_URL=http://127.0.0.1:8088
STATE_DIR=./state
# Preferred: point at files, not values
CRM_TOKEN_FILE=./secrets/crm_token.txt
# Optional. Leave unset to use the template summary (no API calls, no cost).
# ANTHROPIC_API_KEY_FILE=./secrets/anthropic_api_key.txt
# ANTHROPIC_MODEL=claude-sonnet-4-5
